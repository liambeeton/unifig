# built binary
/unifig

# the maintainer's own config, describing a real network. Anchored to the root
# so examples/unifig.yaml — which ships — is unaffected. An operator's own
# unifig.yaml belongs in git; this is the tool's repo, not an operator's.
/unifig.yaml

# pinned tools installed by the Makefile
/bin/

# local connection secrets (direnv workflow)
.envrc

# what each Controller version's suite did, kept by `make matrix`. The table
# generated from these is committed; the raw results are not.
/.matrix/
